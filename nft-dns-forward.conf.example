# nft-dns-forward.conf.example
# 复制此文件为 nft-dns-forward.conf 后编辑使用
#
# ─── 格式 ────────────────────────────────────────────────────────────────────
#
#   name|listen_port|target_host|target_port|source_ip|family|rate_limit|schedule|protocol
#
# ─── 字段说明 ─────────────────────────────────────────────────────────────────
#
# name
#   规则名称，只允许字母、数字、点、下划线、横杠
#   例: cloud-a  my.rule  vps_01
#
# listen_port
#   本机公网监听端口 (1-65535)
#
# target_host
#   转发目标，支持域名或 IP（域名每 60s 自动重解析）
#
# target_port
#   目标端口 (1-65535)
#
# source_ip
#   SNAT 出口 IP，必须是本机已有的 IP 地址
#
# family
#   4    → IPv4
#   6    → IPv6
#   auto → 根据 source_ip 自动判断
#
# rate_limit  【可选，留空=不限速】
#   格式: 数字 + 单位
#   支持单位:
#     mbps  = MBytes/s（兆字节每秒）
#     kbps  = KBytes/s（千字节每秒）
#     mbit  = Mbits/s（兆比特每秒）
#     kbit  = Kbits/s（千比特每秒）
#   例: 50mbps  10mbit  500kbps  1024kbit
#
# schedule  【可选，留空=全天限速（仅当 rate_limit 非空时有意义）】
#   格式: HH:MM-HH:MM
#   支持跨午夜，支持逗号分隔多个时间段
#   时段内 = 限速生效；时段外 = 全速不限
#   例:
#     22:00-08:00                    → 晚上 22 点到早上 8 点
#     08:00-12:00,14:00-18:00        → 上午 8-12 点 + 下午 14-18 点
#     22:00-08:00,12:00-14:00        → 跨午夜 + 中午
#
# protocol  【可选，默认 tcp】
#   tcp / udp / both
#
# ─── 注意事项 ─────────────────────────────────────────────────────────────────
#
# 1. rate_limit 和 schedule 是可选字段，可以省略或留空
#    以下三种写法等价（均表示 TCP、不限速；省略 protocol 时默认 tcp）：
#      cloud-a|44288|example.com|51312|10.0.0.10|4
#      cloud-a|44288|example.com|51312|10.0.0.10|4||
#      cloud-a|44288|example.com|51312|10.0.0.10|4|  |
#
# 2. 有 schedule 的规则由 systemd timer 每 60s 自动判断时间段并切换限速
#
# 3. 有 rate_limit 但无 schedule → 全天限速
#
# 4. 可在菜单中手动「启用/停用限速」临时覆盖，下次 timer sync 后恢复 schedule 逻辑
#
# 5. 限速实现方式：nft meter（per-source-IP token bucket），
#    对每个客户端源 IP 单独限速，而非共享带宽池
#
# ─── 示例 ────────────────────────────────────────────────────────────────────

# 示例 1: 纯转发，不限速（最简格式）
cloud-a|44288|example.com|51312|10.0.0.10|4

# 示例 2: 纯 TCP 转发，不限速（9字段完整格式）
cloud-b|8888|example.com|8888|10.0.0.10|4|||tcp

# 示例 3: 全天限速 50mbps
cloud-c|9001|example.com|9001|10.0.0.10|4|50mbps|

# 示例 4: 仅在 22:00-08:00（夜间）限速 10mbps，白天全速
cloud-d|9002|example.com|9002|10.0.0.10|4|10mbps|22:00-08:00

# 示例 5: 多时间段限速，工作时间（8-12 点和 14-18 点）限速 20mbps
cloud-e|9003|example.com|9003|10.0.0.10|4|20mbps|08:00-12:00,14:00-18:00

# 示例 6: IPv6 转发，不限速
cloud-f|9004|example.com|9004|2001:db8::1|6||

# 示例 7: auto 模式（根据 source_ip 自动判断 IPv4）
cloud-g|9005|example.com|9005|10.0.0.10|auto||

# 示例 8: UDP 转发
dns-udp|5353|1.1.1.1|53|10.0.0.10|4|||udp

# 示例 9: TCP + UDP 转发
game-both|30000|example.com|30000|10.0.0.10|4|||both

# 示例 10: IPv4 UDP 转发，22:00-08:00 限速 10mbit，其余时间不限速
dns-udp-limit|5354|1.1.1.1|53|10.0.0.10|4|10mbit|22:00-08:00|udp
